FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 推荐并优先读取原变量。已有项目请继续保留这一项，无需重新配置飞书。
FEISHU_DOCX_DOCUMENT_ID=
# 兼容变量：仅当上面的 FEISHU_DOCX_DOCUMENT_ID 为空时才读取；二选一即可。
FEISHU_DOCUMENT_ID=

# OpenAI-compatible 大模型配置。AI_API_KEY 留空时自动使用规则版日报。
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

GITHUB_TOKEN=
RSSHUB_BASE_URL=

# 深度日报配置：覆盖 5 条重点、8～12 条普通动态和 3～5 篇论文。
MAX_ITEMS_FOR_AI=20
MAX_TEXT_PER_ITEM=3000
MAX_REPORT_CHARS=22000

# 雷达配置：最终选出 15～25 条；默认 20 条。
AI_RADAR_LIMIT=20
AI_RADAR_LOOKBACK_DAYS=2
AI_RADAR_MAX_PER_SOURCE=4
AI_RADAR_SOURCES_FILE=config/sources.yml

# true 会忽略“同一天已写入”的保护，仅用于明确需要重复写入时。
AI_RADAR_FORCE_WRITE=false
